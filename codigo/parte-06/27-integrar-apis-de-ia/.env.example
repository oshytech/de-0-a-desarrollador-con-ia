# Copia este fichero como .env, rellénalo y no lo subas nunca al repositorio.
# Sin LLM_API_KEY ni LLM_BASE_URL, los ejemplos funcionan en modo simulado.

# Proveedor en la nube:
LLM_BASE_URL=https://api.proveedor-de-ejemplo.com/v1
LLM_API_KEY=clave-de-mentira-no-funciona
LLM_MODEL=identificador-exacto-del-catalogo

# Modelo local compatible (sin clave):
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=nombre-del-modelo-local
