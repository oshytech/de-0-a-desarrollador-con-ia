# Sin ASISTENTE_API_KEY el asistente funciona en modo simulado, sin red.
ASISTENTE_API_KEY=pon-aqui-tu-clave
# Cualquier proveedor compatible con la API de OpenAI (también un servidor local de modelos).
ASISTENTE_API_URL=https://api.openai.com/v1
ASISTENTE_MODELO=gpt-4o-mini
ASISTENTE_MODELO_EMBEDDINGS=text-embedding-3-small
# Fuerza el modo simulado aunque haya clave: simulado
ASISTENTE_MODO=
