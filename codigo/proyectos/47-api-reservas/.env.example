# Copia este fichero a .env y ajusta los valores. El .env no se sube al repositorio.
# Sin RESERVAS_BD la API arranca con los repositorios en memoria.
# Los tests de integración usan la misma variable (y un esquema propio que borran al acabar).
RESERVAS_BD=postgres://reservas:reservas_local@localhost:5432/reservas
# "si" para cargar los socios y pistas de ejemplo (solo en local)
DATOS_DE_EJEMPLO=si
# En tu ordenador, solo 127.0.0.1. Dentro de un contenedor, 0.0.0.0:8080.
DIRECCION=127.0.0.1:8080
ZONA_CLUB=Europe/Madrid
# Puerto de tu ordenador donde docker compose publica PostgreSQL
PUERTO_POSTGRES=5432
