# Variables del asistente. Expórtalas en tu terminal o cárgalas desde un .env
# que no se sube al repositorio. Sin ninguna clave, arranca en modo simulado.

# anthropic, openai, ollama o simulado
ASISTENTE_PROVEEDOR=anthropic
# Vacío: el modelo por defecto del proveedor (obligatorio en openai y ollama)
ASISTENTE_MODELO=
ANTHROPIC_API_KEY=sk-ant-de-mentira
OPENAI_API_KEY=sk-de-mentira
# Por ejemplo http://localhost:11434/v1 para Ollama
ASISTENTE_URL_BASE=
TAVILY_API_KEY=tvly-de-mentira
